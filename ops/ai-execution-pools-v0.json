{
  "schema": 1,
  "status": "CONFIG_REQUIRED",
  "ownerProjectId": "shared-platform",
  "taskTypes": [
    "CODING_WORKER",
    "AI_REVIEW"
  ],
  "allocation": {
    "projectLocalQueues": true,
    "globalFifoHeadBlocking": false,
    "projectPolicies": {},
    "missingProjectPolicy": "CONFIG_REQUIRED",
    "missingSlotCount": "CONFIG_REQUIRED"
  },
  "budget": {
    "initialProjectBudgets": {},
    "missingBudgetForPaidExecution": "CONFIG_REQUIRED",
    "paidModelCalls": "EXPLICIT_APPROVAL_ONLY",
    "automaticPaidRetries": false,
    "preRunEstimateRequired": true,
    "completedAdmissionCharge": "MAX_PRE_RUN_RESERVATION_OR_AUTHORITATIVE_COST"
  },
  "ledger": {
    "commonAcrossTaskTypes": true,
    "identityFields": [
      "projectId",
      "workstreamId",
      "taskId",
      "runId",
      "authorityRef",
      "candidateRef"
    ],
    "candidateRefRequiredFor": [
      "AI_REVIEW"
    ],
    "usageFields": [
      "inputTokens",
      "outputTokens",
      "modelCalls",
      "estimatedCostUsdMicros",
      "authoritativeCostUsdMicros",
      "result",
      "retryCount"
    ],
    "estimateIsNotProviderBilling": true
  },
  "authority": {
    "providerMutation": false,
    "codingWorkerMayWidenAuthority": false,
    "codingWorkerResultAuthority": "CANDIDATE_ONLY",
    "aiReviewResultAuthority": "HYPOTHESIS_ONLY",
    "aiReviewMayMerge": false
  },
  "adapters": {
    "aiReview": {
      "status": "ADAPTER_READY_MANUAL_ONLY",
      "provider": "AWS_BEDROCK",
      "resource": "infra/aws/semantic-review/pool.py",
      "ledgerAdapter": "runner/semantic_review_pool_adapter.py",
      "modelSelection": "infra/aws/semantic-review/model-selection.json",
      "automaticRetry": false,
      "automaticExecution": false,
      "exactCandidateBindingRequired": true,
      "authorityBindingRequired": true
    },
    "codingWorker": {
      "status": "CONFIG_REQUIRED",
      "sourceProjectId": "dashboard-control-center",
      "note": "Shared Platform does not assume consumer-repository execution authority."
    },
    "durableAllocatorStore": {
      "status": "CONFIG_REQUIRED",
      "note": "The core is storage-neutral. Cross-run slot enforcement requires an approved durable compare-and-set or lease adapter; no new credential is created by v0."
    }
  }
}
